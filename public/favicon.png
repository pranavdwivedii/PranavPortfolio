<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#18181f"/>
      <stop offset="100%" stop-color="#09090c"/>
    </linearGradient>
    <linearGradient id="textGrad" x1="0" y1="16" x2="64" y2="48" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#cbd5e1"/>
    </linearGradient>
    <linearGradient id="dotGrad" x1="48" y1="36" x2="56" y2="46" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#1d4ed8"/>
    </linearGradient>
  </defs>
  
  <!-- Sleek Onyx Rounded Square -->
  <rect width="64" height="64" rx="16" fill="url(#bgGrad)"/>
  <rect x="0.75" y="0.75" width="62.5" height="62.5" rx="15.25" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
  
  <!-- Architectural Monogram -->
  <text x="11" y="44" fill="url(#textGrad)" font-family="system-ui, -apple-system, 'SF Pro Display', 'Syne', 'Inter', sans-serif" font-weight="900" font-size="28" letter-spacing="-1.5">PD</text>
  
  <!-- Electric Blue Accent Pulse Dot -->
  <circle cx="51" cy="40" r="4.2" fill="url(#dotGrad)"/>
  <circle cx="51" cy="40" r="6" stroke="#3b82f6" stroke-opacity="0.3" stroke-width="1"/>
</svg>